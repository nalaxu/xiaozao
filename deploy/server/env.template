# 小灶线上环境变量（/etc/howtocook/env）。由 setup.sh 生成，数据库与 OTP/CRON 密钥已自动填好。
# 改完运行 deploy/deploy.sh release 重新构建发布（IMAGE_BASE_URL 和 NEXT_PUBLIC_* 在构建时读取）。
# 含空格或 < > 的值请用双引号括起来，例如 MAIL_FROM="小灶 <noreply@example.com>"。

APP_URL=https://__DOMAIN__

# 服务器本机的 Postgres（只监听 127.0.0.1）。改用 Neon 时换成它的连接串即可
DATABASE_URL=postgresql://howtocook:__DB_PASS__@127.0.0.1:5432/howtocook

# OpenAI（必填）。走代理或中转时填 OPENAI_BASE_URL（含 /v1）
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_RECOGNIZE=
MODEL_RECOMMEND=
MODEL_TUTORIAL=
MODEL_TUTORIAL_FALLBACK=
MODEL_FOLLOWUP=
MODEL_IMAGE=
IMAGE_QUALITY=medium

# 图片存储：默认存本机磁盘，由 Caddy 在 /images 下提供。
# 改用 Cloudflare R2 时填写 R2_*，并把 IMAGE_BASE_URL 改成 R2 的公开地址（R2 优先于 IMAGE_DIR）
IMAGE_DIR=/var/lib/howtocook/images
IMAGE_BASE_URL=https://__DOMAIN__/images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend（必填：邮箱验证码、邀请、花费告警）
RESEND_API_KEY=
MAIL_FROM=

# Cloudflare Turnstile（必填：线上未配置时发验证码一律被拒，无法登录。站点密钥在构建时读取）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google 登录（可选）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OTP_SECRET=__OTP_SECRET__
CRON_SECRET=__CRON_SECRET__

# 管理员邮箱，逗号分隔（必填）
ADMIN_EMAILS=

# 预算阈值（美元），不填用默认值 50 / 80 / 95 / 100，单账号告警线 1
# BUDGET_NOTIFY=
# BUDGET_STOP_IMAGES=
# BUDGET_DOWNGRADE=
# BUDGET_CAP=
# BUDGET_ACCOUNT_ALERT=

# 可选：隐私政策页上的联系邮箱（构建时读取）
CONTACT_EMAIL=

# 试验：首页 3D 砧板（docs/xiaozao-3d-interaction-plan.md）。填 1 对所有人默认开启；不填时只有在网址加 ?board3d=1 的设备才显示
# ENABLE_3D_BOARD=
