[Unit]
Description=Xiaozao (howtocook) Next.js server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=howtocook
Group=howtocook
WorkingDirectory=/opt/howtocook/current
EnvironmentFile=/etc/howtocook/env
Environment=NODE_ENV=production
# 只监听本机，外部经 Caddy（HTTPS）访问
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3
TimeoutStopSec=20

# 加固：只允许写图片目录和程序自身目录（Next 的缓存在 .next/cache）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/howtocook /opt/howtocook
MemoryHigh=2G
MemoryMax=2560M

[Install]
WantedBy=multi-user.target
