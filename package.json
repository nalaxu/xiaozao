{
  "name": "xiaozao",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run kb",
    "dev": "next dev",
    "prebuild": "npm run kb",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "kb": "tsx scripts/build-kb.ts",
    "kb:check": "tsx scripts/build-kb.ts --check",
    "pretest": "npm run kb",
    "test": "vitest run",
    "pretypecheck": "npm run kb",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "admin:invite": "tsx --env-file-if-exists=.env.local scripts/admin-invite.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@fontsource/ma-shan-zheng": "^5.3.1",
    "@neondatabase/serverless": "^1.0.2",
    "@react-three/fiber": "^9.8.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.544.0",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.187.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
