# 复制为 .env.local 填写；线上在 Vercel 的环境变量中配置。不要提交真实值。

# 站点地址，例如 https://xiaozao.<已有域名>
APP_URL=http://localhost:3000

# Neon Postgres
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=
# 以下可选，不填则用 config/models.ts 中的默认值
MODEL_RECOGNIZE=
MODEL_RECOMMEND=
MODEL_TUTORIAL=
MODEL_TUTORIAL_FALLBACK=
MODEL_FOLLOWUP=
MODEL_IMAGE=
IMAGE_QUALITY=medium

# Cloudflare R2（图片库）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
IMAGE_BASE_URL=

# Resend（验证码与告警邮件）
RESEND_API_KEY=
MAIL_FROM=

# Cloudflare Turnstile（真人验证）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google 登录
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 随机长字符串：openssl rand -hex 32
OTP_SECRET=
CRON_SECRET=

# 管理员邮箱，逗号分隔
ADMIN_EMAILS=

# 可选
SENTRY_DSN=
