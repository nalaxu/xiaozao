# 复制为 .env.local 填写；线上在 Vercel 的环境变量中配置。不要提交真实值。

# 站点地址，例如 https://xiaozao.<已有域名>
APP_URL=http://localhost:3000

# Neon Postgres
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=
# 可选：OpenAI 兼容的代理或中转地址（含 /v1），不填用 https://api.openai.com/v1
OPENAI_BASE_URL=
# 以下可选，不填则用 config/models.ts 中的默认值
MODEL_RECOGNIZE=
MODEL_RECOMMEND=
MODEL_TUTORIAL=
MODEL_TUTORIAL_FALLBACK=
MODEL_FOLLOWUP=
MODEL_IMAGE=
IMAGE_QUALITY=medium

# Cloudflare R2（图片库）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
IMAGE_BASE_URL=

# Resend（验证码与告警邮件）
RESEND_API_KEY=
MAIL_FROM=

# Cloudflare Turnstile（真人验证）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google 登录
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 随机长字符串：openssl rand -hex 32
OTP_SECRET=
CRON_SECRET=

# 管理员邮箱，逗号分隔。花费告警也发到这些邮箱
ADMIN_EMAILS=

# 可选：预算阈值（美元），不填用默认值 50 / 80 / 95 / 100，单账号告警线 1
# BUDGET_NOTIFY=
# BUDGET_STOP_IMAGES=
# BUDGET_DOWNGRADE=
# BUDGET_CAP=
# BUDGET_ACCOUNT_ALERT=

# 可选（尚未接入，见技术方案第 14 节）
SENTRY_DSN=
